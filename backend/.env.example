PORT=5000
DATABASE_URL="file:./dev.db" # In production with PostgreSQL: "postgresql://user:password@localhost:5432/ncrb_doc_db?schema=public"
JWT_SECRET="replace_with_strong_random_secret"
JWT_REFRESH_SECRET="replace_with_strong_refresh_secret"
STORAGE_PATH="./uploads"
NODE_ENV="development"
AI_API_KEY="optional_openai_or_gemini_key"
BLOCKCHAIN_NETWORK="simulated-hyperledger-fabric" # or "ethereum-sepolia" / "hyperledger-fabric"
PRIVACYIDEA_URL="http://127.0.0.1:5001" # privacyIDEA 3.13+ REST API Endpoint
PRIVACYIDEA_REALM="defrealm"
PRIVACYIDEA_ADMIN_USER="admin"
PRIVACYIDEA_ADMIN_PASSWORD="privacyidea2026"

# SMS Gateway Configuration for Real Mobile Phone SMS Delivery:
# Option A: Twilio (Global SMS)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Option B: Fast2SMS (Free / Instant SMS for Indian +91 numbers)
# FAST2SMS_API_KEY="your_fast2sms_api_key"

# Option C: Custom HTTP SMS Gateway (from privacyIDEA Section 1.5.8)
# SMS_GATEWAY_URL="https://your-sms-api.com/send?to={phone}&text={otp}"

