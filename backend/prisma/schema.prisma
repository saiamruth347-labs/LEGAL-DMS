// Prisma Schema for NCRB Secure Digital Document Management System (SIH26190)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  description String?
  users       User[]
  cases       Case[]
  createdAt   DateTime   @default(now())
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  fullName            String
  badgeNumber         String             @unique
  role                String             // SUPER_ADMIN, INVESTIGATING_OFFICER, LEGAL_OFFICER, REVIEWER, AUDITOR
  departmentId        String?
  department          Department?        @relation(fields: [departmentId], references: [id])
  failedLoginAttempts Int                @default(0)
  isLocked            Boolean            @default(false)
  lockoutUntil        DateTime?
  isActive            Boolean            @default(true)
  phoneNumber         String?
  currentChallenge    String?
  passkeys            PasskeyCredential[]
  createdCases        Case[]             @relation("CaseCreator")
  assignedCases       Case[]             @relation("CaseAssignee")
  uploadedDocs        Document[]         @relation("DocumentUploader")
  docVersions         DocumentVersion[]  @relation("VersionCreator")
  digitalSignatures   DigitalSignature[] @relation("UserSignatures")
  accessRequests      AccessRequest[]    @relation("UserRequests")
  reviewedRequests    AccessRequest[]    @relation("ReviewerRequests")
  auditLogs           AuditLog[]
  notifications       Notification[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([email])
  @@index([role])
}

model PasskeyCredential {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  citizenPhone String?
  credentialID String   @unique
  publicKey    String
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([citizenPhone])
}

model Case {
  id                String          @id // e.g. CASE-2026-001
  title             String
  caseType          String          // WOMEN_SAFETY, CYBER_CRIME, FINANCIAL_FRAUD, NARCOTICS, SPECIAL_INVESTIGATION
  description       String
  priority          String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status            String          @default("OPEN") // OPEN, UNDER_INVESTIGATION, LEGAL_REVIEW, COURT_SUBMITTED, CLOSED, ARCHIVED
  firNumber         String?
  incidentDate      DateTime?
  assignedOfficerId String?
  assignedOfficer   User?           @relation("CaseAssignee", fields: [assignedOfficerId], references: [id])
  createdById       String
  creator           User            @relation("CaseCreator", fields: [createdById], references: [id])
  departmentId      String?
  department        Department?     @relation(fields: [departmentId], references: [id])
  documents         Document[]
  accessRequests    AccessRequest[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([priority])
  @@index([caseType])
}

model Document {
  id                  String             @id // e.g. DOC-2026-0001
  caseId              String
  case                Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title               String
  fileName            String
  filePath            String
  mimeType            String             @default("application/pdf")
  fileSize            Int                @default(0)
  category            String             // FIR, POLICE_REPORT, INVESTIGATION_RECORD, WITNESS_STATEMENT, CHARGE_SHEET, COURT_FILING, EVIDENCE_RECORD, FORENSIC_REPORT, LEGAL_NOTICE, JUDGMENT, OTHER
  classification      String             @default("CONFIDENTIAL") // PUBLIC, INTERNAL, CONFIDENTIAL, HIGHLY_CONFIDENTIAL, RESTRICTED
  currentHash         String             // SHA-256 fingerprint
  currentVersion      String             @default("1.0")
  uploadedById        String
  uploadedBy          User               @relation("DocumentUploader", fields: [uploadedById], references: [id])
  isArchived          Boolean            @default(false)
  summary             String?            // AI generated summary cache
  extractedEntities   String?            // AI JSON string: suspects, locations, IPC/BNS sections
  versions            DocumentVersion[]
  integrityRecords    IntegrityLedger[]
  digitalSignatures   DigitalSignature[]
  accessRequests      AccessRequest[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([caseId])
  @@index([category])
  @@index([classification])
  @@index([currentHash])
}

model DocumentVersion {
  id                String            @id @default(uuid())
  documentId        String
  document          Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber     String            // e.g. "1.0", "1.1", "2.0"
  filePath          String
  fileHash          String            // SHA-256 hash of this specific version
  fileSize          Int               @default(0)
  changeDescription String?
  createdById       String
  createdBy         User              @relation("VersionCreator", fields: [createdById], references: [id])
  digitalSignatures DigitalSignature[]
  createdAt         DateTime          @default(now())

  @@index([documentId])
  @@index([fileHash])
}

model IntegrityLedger {
  id              String    @id @default(uuid())
  blockIndex      Int       @unique
  documentId      String?
  document        Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentHash    String    // SHA-256 of document content
  previousHash    String    // Previous block's hash (Blockchain chaining)
  blockHash       String    @unique // SHA-256(blockIndex + documentHash + previousHash + timestamp + validator)
  timestamp       DateTime  @default(now())
  validator       String    @default("NCRB-INTEGRITY-NODE-01")
  status          String    @default("VERIFIED") // VERIFIED, TAMPERED_FLAGGED
  merkleRoot      String?
  notes           String?

  @@index([documentHash])
  @@index([blockIndex])
}

model DigitalSignature {
  id              String           @id // e.g. SIG-2026-XXXX
  documentId      String
  document        Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId       String?
  version         DocumentVersion? @relation(fields: [versionId], references: [id])
  signerUserId    String
  signer          User             @relation("UserSignatures", fields: [signerUserId], references: [id])
  signerName      String
  signerRole      String
  signatureHash   String           // Cryptographic signature token
  signatureReason String?
  certificateInfo String?          // Mock PKI / DSC certificate metadata
  timestamp       DateTime         @default(now())
  isValid         Boolean          @default(true)

  @@index([documentId])
  @@index([signerUserId])
}

model AccessRequest {
  id              String    @id @default(uuid())
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  caseId          String
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requesterUserId String
  requester       User      @relation("UserRequests", fields: [requesterUserId], references: [id])
  requestedRole   String
  reason          String
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById    String?
  reviewedBy      User?     @relation("ReviewerRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewRemarks   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([documentId])
  @@index([requesterUserId])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String
  userRole     String
  action       String   // LOGIN, LOGOUT, DOCUMENT_UPLOAD, DOCUMENT_DOWNLOAD, DOCUMENT_VIEW, etc.
  resourceType String   // DOCUMENT, CASE, USER, ACCESS_REQUEST, SYSTEM
  resourceId   String?  // ID of the resource
  ipAddress    String   @default("127.0.0.1")
  userAgent    String?
  status       String   @default("SUCCESS") // SUCCESS, DENIED, FAILED, WARNING
  details      String?  // JSON string or summary

  @@index([timestamp])
  @@index([userId])
  @@index([action])
  @@index([resourceId])
}

model SecurityEvent {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  eventType   String   // FAILED_LOGIN, SUSPICIOUS_DOWNLOAD, UNAUTHORIZED_ACCESS_ATTEMPT, INTEGRITY_MISMATCH, ACCOUNT_LOCKOUT
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  description String
  ipAddress   String   @default("127.0.0.1")
  userId      String?
  userName    String?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  metadata    String?

  @@index([timestamp])
  @@index([severity])
  @@index([resolved])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, CRITICAL, ACCESS
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
